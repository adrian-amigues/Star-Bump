:root {
}

.try-again-button {
    width: auto;
    font-size: 32px;
    -unity-font-definition: url("project://database/Assets/ThirdParty/Feel/NiceVibrations/Demo/Common/Fonts/BIG%20JOHN.otf?fileID=12800000&guid=7015f2d2ce595844e9fe6e0c3bd8d27b&type=3#BIG JOHN");
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    background-color: rgba(188, 188, 188, 0);
    -unity-text-outline-color: rgb(255, 73, 254);
    -unity-text-outline-width: 2px;
    border-left-color: rgb(75, 255, 254);
    border-right-color: rgb(75, 255, 254);
    border-top-color: rgb(75, 255, 254);
    border-bottom-color: rgb(75, 255, 254);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-font-style: bold;
    transition-property: all;
    transition-duration: 0.1s;
    transition-timing-function: ease-in-out;
    position: relative;
}

.try-again-button:hover {
    -unity-text-outline-color: rgb(75, 255, 254);
    border-left-color: rgb(255, 73, 254);
    border-right-color: rgb(255, 73, 254);
    border-top-color: rgb(255, 73, 254);
    border-bottom-color: rgb(255, 73, 254);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}
