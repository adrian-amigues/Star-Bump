<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Menu/GameOver.uss?fileID=7433441132597879392&amp;guid=cc186904109dc4e859ac3a1706603aa7&amp;type=3#GameOver" />
    <ui:VisualElement style="flex-grow: 1; position: absolute; bottom: 0; right: 0; left: 0; top: 0; align-items: center; justify-content: center; flex-direction: row;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; justify-content: center; margin-bottom: 0%; align-items: center; flex-direction: row;">
            <ui:Label text="GAME OVER" style="color: rgb(221, 241, 240); font-size: 90px; -unity-font-definition: url(&quot;project://database/Assets/ThirdParty/Feel/NiceVibrations/Demo/Common/Fonts/BIG%20JOHN.otf?fileID=12800000&amp;guid=7015f2d2ce595844e9fe6e0c3bd8d27b&amp;type=3#BIG JOHN&quot;); -unity-font-style: normal; margin-bottom: 18%;" />
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; position: absolute; top: 82%; align-items: auto; justify-content: center; align-self: auto; align-content: center; flex-direction: column; height: 78px;">
                <ui:Button text="Try again" display-tooltip-when-elided="false" name="tryAgainButton" class="try-again-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
